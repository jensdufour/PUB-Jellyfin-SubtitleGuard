<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Jellyfin.Plugin.SubtitleGuard.Prototype</AssemblyName>
    <Version>0.3.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <Reference Include="MediaBrowser.MediaEncoding" HintPath="$(JellyfinBin)/MediaBrowser.MediaEncoding.dll" Private="false" />
    <Compile Include="PluginEntry.cs" />
    <Compile Include="NativeExtractionGuard.cs" />
  </ItemGroup>
  <Target Name="RequireHostAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(JellyfinBin)/MediaBrowser.MediaEncoding.dll')" Text="Set JellyfinBin to a Jellyfin 12 release bin directory." />
  </Target>
</Project>