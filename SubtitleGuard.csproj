<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Jellyfin.Plugin.SubtitleGuard.Prototype</AssemblyName>
    <Version>0.1.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="libse" Version="4.0.12" ExcludeAssets="runtime" />
    <Reference Include="MediaBrowser.MediaEncoding" HintPath="$(JellyfinBin)/MediaBrowser.MediaEncoding.dll" Private="false" />
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
  <Target Name="RequireHostAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(JellyfinBin)/MediaBrowser.MediaEncoding.dll')" Text="Set JellyfinBin to an isolated Jellyfin 12.0 release bin directory." />
  </Target>
</Project>